def read_request_arg(value, path, stdin):
    if path:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    if value in (None, "-"):
        return json.load(stdin or sys.stdin)
    return json.loads(value)


def cmd_doctor(args, cfg):
    endpoints = parse_endpoints(",".join(args.endpoint)) if args.endpoint else cfg["endpoints"]
    pin = pinned_digest(cfg, cfg["model"])
    out = {"model": cfg["model"], "model_digest": pin, "endpoints": []}
    for ep in endpoints:
        ok, version = probe(ep["url"])
        row = {"name": ep["name"], "url": ep["url"], "reachable": ok, "version": version}
        if ok:
            try:
                _, tags = http_json("GET", ep["url"] + "/api/tags", timeout=3)
                entry = next((m for m in (tags or {}).get("models", []) or []
                              if isinstance(m, dict) and (_same_model(m.get("name"), cfg["model"])
                                                          or _same_model(m.get("model"), cfg["model"]))),
                             None)
                row["model_present"] = entry is not None
                digest = _norm_digest(entry["digest"]) if entry and entry.get("digest") else None
                row["digest"] = digest[:12] if digest else None
                row["digest_match"] = digest.startswith(pin) if (digest and pin) else None
            except Exception:
                row["model_present"] = None
        out["endpoints"].append(row)
    key = read_typesafe_key()
    out["typesafe"] = {"key": (key[:8] + "…") if key else None,
                       "daily_input_token_cap": cfg["typesafe"]["daily_input_token_cap"],
                       "used_today": today_tokens("typesafe")}
    out["local_tokens_today"] = today_tokens("local")
    return out


def predicted_confidence(ans):
    t = ans.get("type")
    if t == "noul":
        p = float(ans.get("noul", 0.5))
        return max(p, 1 - p)
    probs = ans.get("probabilities") or {}
    return max(probs.values()) if probs else 0.0


def is_correct(item, ans):
    t = item["type"]
    if t == "noul":
        return (float(ans.get("noul", 0)) >= 0.5) == bool(item["expected"])
    if t == "choice":
        return ans.get("choice") == item["expected"]
    probs = ans.get("probabilities") or {}
    if probs:
        best = max(probs.items(), key=lambda kv: kv[1])[0]
        return int(best) == int(item["expected"])
    return round(float(ans.get("score", -1))) == int(item["expected"])


def ece(pairs, bins=10):
    if not pairs:
        return None
    total = 0.0
    for b in range(bins):
        lo, hi = b / bins, (b + 1) / bins
        sel = [(c, ok) for c, ok in pairs if (lo < c <= hi) or (b == 0 and c == 0)]
        if sel:
            conf = sum(c for c, _ in sel) / len(sel)
            acc = sum(1 for _, ok in sel if ok) / len(sel)
            total += len(sel) / len(pairs) * abs(conf - acc)
    return round(total, 4)


def percentile(xs, q):
    if not xs:
        return None
    xs = sorted(xs)
    k = (len(xs) - 1) * q
    f, c = math.floor(k), math.ceil(k)
    return xs[int(k)] if f == c else xs[f] + (xs[c] - xs[f]) * (k - f)


def cmd_eval(args, cfg):
    path = args.file or os.path.join(SKILL_DIR, "evals", "labeled.jsonl")
    with open(path, encoding="utf-8") as f:
        items = [json.loads(l) for l in f if l.strip() and not l.lstrip().startswith("//")]
    pairs, lat, by_type, served, failures, misses = [], [], {}, {}, [], []
    for it in items:
        q = {"type": it["type"], "instructions": it["instructions"]}
        if "criteria" in it:
            q["criteria"] = it["criteria"]
        req = {"state": it["state"], "questions": {"q": q}}
        t0 = time.time()
        try:
            data = run_request(req, args, cfg)
        except JevError as e:
            failures.append({"id": it.get("id"), "error": str(e)})
            continue
        lat.append((time.time() - t0) * 1000)
        ans = data["answers"]["q"]
        ok = is_correct(it, ans)
        pairs.append((predicted_confidence(ans), ok))
        if not ok:
            got = {k: ans.get(k) for k in ("noul", "choice", "score", "probabilities") if k in ans}
            misses.append({"id": it.get("id"), "expected": it["expected"], "got": got})
        s = by_type.setdefault(it["type"], [0, 0])
        s[0] += 1 if ok else 0
        s[1] += 1
        served[data.get("served_by")] = served.get(data.get("served_by"), 0) + 1
    correct = sum(1 for _, ok in pairs if ok)
    return {"file": path, "model": args.model or cfg["model"], "n": len(items),
            "answered": len(pairs), "correct": correct,
            "accuracy": round(correct / len(pairs), 4) if pairs else None,
            "by_type": {k: {"correct": v[0], "n": v[1], "accuracy": round(v[0] / v[1], 4)}
                        for k, v in by_type.items()},
            "ece": ece(pairs),
            "latency_ms_p50": round(percentile(lat, 0.5), 1) if lat else None,
            "latency_ms_p95": round(percentile(lat, 0.95), 1) if lat else None,
            "served_by": served, "misses": misses, "failures": failures}


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        print(json.dumps({"error": message}, ensure_ascii=False, indent=2))
        raise SystemExit(EXIT_BAD_REQUEST)


def _global_options(suppress):
    """全域選項；子指令版預設 SUPPRESS，才不會蓋掉放在子指令前的值。"""
    g = JsonArgumentParser(add_help=False)
    d = argparse.SUPPRESS if suppress else None
    g.add_argument("--backend", choices=["local", "typesafe"], default=d,
                   help="預設 local；typesafe 會花錢")
    g.add_argument("--endpoint", action="append", default=d,
                   help="覆寫 endpoint，可重複；格式 name=url 或 url")
    g.add_argument("--model", default=d, help="覆寫模型（local 預設看 config.json）")
    g.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS if suppress else False,
                   help="只印出要送的請求，不連任何網路")
    return g


def build_parser():
    p = JsonArgumentParser(prog="jev", description="Jev 相容判斷 CLI（預設本地 Ollama，0 元）",
                           parents=[_global_options(False)])
    gp = _global_options(True)
    sub = p.add_subparsers(dest="cmd")
    a = sub.add_parser("ask", help="送完整 Jev request JSON", parents=[gp])
    a.add_argument("json", nargs="?", help="request JSON；'-' 或省略＝從 stdin 讀")
    a.add_argument("-f", "--file", help="從檔案讀 request JSON")
    n = sub.add_parser("noul", help="是非題：jev noul STATE QUESTION", parents=[gp])
    n.add_argument("state")
    n.add_argument("question")
    c = sub.add_parser("choice", help="多選一：jev choice STATE QUESTION OPT OPT…", parents=[gp])
    c.add_argument("state")
    c.add_argument("question")
    c.add_argument("options", nargs="+")
    s = sub.add_parser("score", help="刻度：jev score STATE QUESTION LOW … HIGH", parents=[gp])
    s.add_argument("state")
    s.add_argument("question")
    s.add_argument("levels", nargs="+")
    sub.add_parser("doctor", help="檢查 endpoint、模型、key、今日用量", parents=[gp])
    e = sub.add_parser("eval", help="跑標註測試集，輸出準確率／ECE／延遲", parents=[gp])
    e.add_argument("file", nargs="?")
    return p


def main(argv=None, stdin=None):
    _AUTOSTARTED.clear()
    try:
        args = build_parser().parse_args(argv)
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else EXIT_OK
    try:
        cfg = load_config()
        if args.cmd == "ask":
            result = run_request(read_request_arg(args.json, args.file, stdin), args, cfg)
        elif args.cmd == "noul":
            result = run_request({"state": args.state, "questions": {
                "answer": {"type": "noul", "instructions": args.question}}}, args, cfg)
        elif args.cmd == "choice":
            dups = list(dict.fromkeys(o for i, o in enumerate(args.options)
                                      if o in args.options[:i]))
            if dups:
                raise JevError("choice 選項重複：%s；每個選項只能出現一次（不會自動合併）"
                               % "、".join(dups), EXIT_BAD_REQUEST)
            result = run_request({"state": args.state, "questions": {
                "answer": {"type": "choice", "instructions": args.question,
                           "criteria": {o: None for o in args.options}}}}, args, cfg)
        elif args.cmd == "score":
            result = run_request({"state": args.state, "questions": {
                "answer": {"type": "score", "instructions": args.question,
                           "criteria": list(args.levels)}}}, args, cfg)
        elif args.cmd == "doctor":
            result = cmd_doctor(args, cfg)
        elif args.cmd == "eval":
            result = cmd_eval(args, cfg)
        else:
            build_parser().print_help()
            return EXIT_BAD_REQUEST
    except JevError as e:
        out = {"error": str(e)}
        if e.detail is not None:
            out["detail"] = e.detail
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return e.code
    except (ValueError, OSError) as e:
        print(json.dumps({"error": "輸入或檔案錯誤：%s" % e}, ensure_ascii=False, indent=2))
        return EXIT_BAD_REQUEST
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
